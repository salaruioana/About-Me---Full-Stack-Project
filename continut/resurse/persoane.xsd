<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">


  <xs:complexType name="tipAdresa">
    <xs:sequence>
      <xs:element name="strada" type="xs:string"/>
      <xs:element name="numar" type="xs:integer"/>
      <xs:element name="localitate" type="xs:string"/>
      <xs:element name="judet" type="xs:string"/>
      <xs:element name="tara" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipJob">
    <xs:sequence>
      <xs:element name="companie" type="xs:string"/>
      <xs:element name="rol" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tipPersoana">
    <xs:sequence>
      <xs:element name="nume" type="xs:string"/>
      <xs:element name="prenume" type="xs:string"/>
      <xs:element name="varsta" type="xs:integer"/>
      <xs:element name="adresa" type="tipAdresa"/>
      <xs:element name="job" type="tipJob"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:integer" use="required"/>
  </xs:complexType>

  <xs:element name="persoane">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="persoana" type="tipPersoana" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
